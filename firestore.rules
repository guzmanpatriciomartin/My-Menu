rules_version = '2';

// F-1/F-2: deny-all. The database is reached ONLY by the trusted backend via the
// Firebase Admin SDK, which bypasses these rules by design. The browser never talks to
// Firestore directly — it goes through the authenticated /api layer. Any client-SDK
// access (which these rules govern) must be rejected, so no `if true` anywhere.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
