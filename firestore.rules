rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /establishments/{docId} {
      allow read, write: if true;
    }
    match /categories/{docId} {
      allow read, write: if true;
    }
    match /menuItems/{docId} {
      allow read, write: if true;
    }
    match /tables/{docId} {
      allow read, write: if true;
    }
    match /orders/{docId} {
      allow read, write: if true;
    }
    match /tableCalls/{docId} {
      allow read, write: if true;
    }
    // Cash closes are accounting records. They follow the same open-access decision as
    // the rest of the database (see SECURITY_BACKLOG.md): the backend reaches Firestore
    // with the client SDK, so it is subject to these rules and cannot write if they are
    // closed. Anything financial makes tightening this more urgent, not less.
    match /cashCloses/{docId} {
      allow read, write: if true;
    }
  }
}

