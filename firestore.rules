rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /establishments/{docId} {
      allow read, write: if true;
    }
    match /categories/{docId} {
      allow read, write: if true;
    }
    match /menuItems/{docId} {
      allow read, write: if true;
    }
    match /tables/{docId} {
      allow read, write: if true;
    }
    match /orders/{docId} {
      allow read, write: if true;
    }
    match /tableCalls/{docId} {
      allow read, write: if true;
    }
    // Cash closes are accounting records. They follow the same open-access decision as
    // the rest of the database (see SECURITY_BACKLOG.md): the backend reaches Firestore
    // with the client SDK, so it is subject to these rules and cannot write if they are
    // closed. Anything financial makes tightening this more urgent, not less.
    match /cashCloses/{docId} {
      allow read, write: if true;
    }
    match /cashRegisters/{docId} {
      allow read, write: if true;
    }
    // Added late: the store has been writing (store.ts) and listening on this collection
    // since f276b15, but there was no rule for it. Firestore denies by default on any path
    // without one, so every write failed, the error was swallowed by a console.error, and
    // the receipts survived only in memory — lost on each restart. Same open-access
    // decision as the rest of the database; see ADR-006 for closing all of this.
    match /tableCloses/{docId} {
      allow read, write: if true;
    }
  }
}

